    //get statistics, match dashboard
    public List<FixtureStats> getStatsForFixture(int fixtureId) {
    	//create rest template object to make http requests, 
        RestTemplate restTemplate = new RestTemplate();
        //set up http headers for api access
        HttpHeaders headers = new HttpHeaders();
        headers.set("x-rapidapi-key", "1c50bcaccdmsh24da0059f6cea8ap10c332jsn3680464f84d3");
        headers.set("x-rapidapi-host", "api-football-v1.p.rapidapi.com");
        HttpEntity<String> entity = new HttpEntity<>(headers);

        //construct url
        String statsUrl = "https://api-football-v1.p.rapidapi.com/v3/fixtures/statistics?fixture=" + fixtureId;

        try {
        	//make the GET request to API endpoint
            ResponseEntity<String> response = restTemplate.exchange(statsUrl, HttpMethod.GET, entity, String.class);
            //Parse response body as JSON
            ObjectMapper objectMapper = new ObjectMapper();
            JsonNode rootNode = objectMapper.readTree(response.getBody());
            
            List<FixtureStats> statsList = new ArrayList<>();

            if (rootNode != null && rootNode.has("response")) {
            	//extract the response node if response is not null
                JsonNode responseNode = rootNode.get("response");
                //iterate over each team and extract information
                for (JsonNode statsNode : responseNode) {
                    JsonNode teamNode = statsNode.get("team");
                    String teamName = teamNode.has("name") ? teamNode.get("name").asText() : "";
                    String teamLogo = teamNode.has("logo") ? teamNode.get("logo").asText() : "";

                    List<Stat> statistics = new ArrayList<>();
                    //extract and parse each individual statistic entry
                    JsonNode statsArrayNode = statsNode.get("statistics");
                    if (statsArrayNode != null && statsArrayNode.isArray()) {
                        for (JsonNode statNode : statsArrayNode) {
                            String type = statNode.get("type").asText();
                            JsonNode valueNode = statNode.get("value");
                            Object value;
                            if (valueNode.isInt()) {
                            	value = valueNode.asInt();

                            } else if (valueNode.isTextual()) {
                            	value = valueNode.asText();
                            } else {
                            	value = 0;
                            }
                            
                         statistics.add(new Stat(type, value));
                        }
                    }

                    FixtureStats fixtureStats = new FixtureStats(teamName, teamLogo, statistics);
                    statsList.add(fixtureStats);
                }
            }

            return statsList;
        } catch (IOException e) {
            e.printStackTrace();
            return Collections.emptyList();
        }
    }
    
    //get lineups, match dashboard functionality
    public List<Lineup> getLineupsForFixture(int fixtureId) {
        RestTemplate restTemplate = new RestTemplate();
        HttpHeaders headers = new HttpHeaders();
        headers.set("x-rapidapi-key", "1c50bcaccdmsh24da0059f6cea8ap10c332jsn3680464f84d3");
        headers.set("x-rapidapi-host", "api-football-v1.p.rapidapi.com");
        HttpEntity<String> entity = new HttpEntity<>(headers);

        String lineupsUrl = "https://api-football-v1.p.rapidapi.com/v3/fixtures/lineups?fixture=" + fixtureId;

        try {
            ResponseEntity<String> response = restTemplate.exchange(lineupsUrl, HttpMethod.GET, entity, String.class);
            ObjectMapper objectMapper = new ObjectMapper();
            JsonNode rootNode = objectMapper.readTree(response.getBody());
            List<Lineup> lineups = new ArrayList<>();

            if (rootNode != null && rootNode.has("response")) {
                JsonNode responseNode = rootNode.get("response");

                for (JsonNode lineupNode : responseNode) {
                    JsonNode teamNode = lineupNode.get("team");
                    String teamName = teamNode.has("name") ? teamNode.get("name").asText() : "";
                    String teamLogoUrl = teamNode.has("logo") ? teamNode.get("logo").asText() : "";

                    JsonNode coachNode = lineupNode.get("coach");
                    String coachName = coachNode.has("name") ? coachNode.get("name").asText() : "";
                    
                    String formation = lineupNode.has("formation") ? lineupNode.get("formation").asText() : "";
                    
                    // get starting 11 
                    List<PlayerDTO> startXI = new ArrayList<>();
                    JsonNode startXINode = lineupNode.get("startXI");
                    if (startXINode != null && startXINode.isArray()) {
                        for (JsonNode playerNode : startXINode) {
                            JsonNode playerInfo = playerNode.get("player");
                            String playerName = playerInfo.has("name") ? playerInfo.get("name").asText() : "";
                            
                            int playerNumber = playerInfo.has("number") ? playerInfo.get("number").asInt() : 0;

                            PlayerDTO player = new PlayerDTO(playerName, playerNumber);
                            startXI.add(player);
                        }
                    }
                    
                    // get substitutes
                    List<PlayerDTO> substitutes = new ArrayList<>();
                    JsonNode substitutesNode = lineupNode.get("substitutes");
                    if (substitutesNode != null && substitutesNode.isArray()) {
                        for (JsonNode playerNode : substitutesNode) {
                            JsonNode playerInfo = playerNode.get("player");
                            String playerName = playerInfo.has("name") ? playerInfo.get("name").asText() : "";
                            int playerNumber = playerInfo.has("number") ? playerInfo.get("number").asInt() : 0;
                       
                            PlayerDTO player = new PlayerDTO( playerName, playerNumber);
                            substitutes.add(player);
                        }
                    }
                    
                    Lineup lineup = new Lineup( teamName, teamLogoUrl, coachName, formation, startXI, substitutes);
                    lineups.add(lineup);
                }
            }

            return lineups;
        } catch (IOException e) {
            e.printStackTrace();
            return Collections.emptyList();
        }
    }

    //get events for fixture, match dashboard functionality
    public List<Event> getEventsForFixture(int fixtureId) {
        RestTemplate restTemplate = new RestTemplate();
        HttpHeaders headers = new HttpHeaders();
        headers.set("x-rapidapi-key", "1c50bcaccdmsh24da0059f6cea8ap10c332jsn3680464f84d3");
        headers.set("x-rapidapi-host", "api-football-v1.p.rapidapi.com");
        HttpEntity<String> entity = new HttpEntity<>(headers);

        String eventsUrl = "https://api-football-v1.p.rapidapi.com/v3/fixtures/events?fixture=" + fixtureId;

        try {
            ResponseEntity<String> response = restTemplate.exchange(eventsUrl, HttpMethod.GET, entity, String.class);
            ObjectMapper objectMapper = new ObjectMapper();
            JsonNode rootNode = objectMapper.readTree(response.getBody());
            List<Event> events = new ArrayList<>();

            if (rootNode != null && rootNode.has("response")) {
                JsonNode eventsNode = rootNode.get("response");

                for (JsonNode eventNode : eventsNode) {
                    int timeElapsed = eventNode.get("time").get("elapsed").asInt();
                    int timeExtra = eventNode.get("time").get("extra").asInt();
                    
                    if (eventNode.get("time").get("extra").isNull()) {
                        timeExtra = 0;
                    }
                    int time = timeElapsed + timeExtra;
                    String teamName = eventNode.get("team").get("name").asText();
                    String teamLogo = eventNode.get("team").get("logo").asText();
                    String player = eventNode.get("player").get("name").asText();
                    String assist = eventNode.has("assist") ? eventNode.get("assist").get("name").asText() : "";
                    String type = eventNode.get("type").asText();
                    String detail = eventNode.get("detail").asText();
                    String comments = eventNode.has("comments") ? eventNode.get("comments").asText() : "";
                    
                    if(assist.equals("null")) {
                    	assist = "";
                    }
                    if (comments.equals("null")) {
                    	comments = "";
                    }

                    Event event = new Event(time, teamName, teamLogo, player, assist, type, detail, comments);
                    events.add(event);
                                        
                }
            }

            return events;
        } catch (IOException e) {
            e.printStackTrace();
            return Collections.emptyList();
        }
    }
    
