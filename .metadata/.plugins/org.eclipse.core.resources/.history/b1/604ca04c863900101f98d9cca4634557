    //get events for fixtureid list based on each referee
    public List<Event> getEventsForFixtures(List<Integer> fixtureIds) {
        List<Event> allEvents = new ArrayList<>();
        RestTemplate restTemplate = new RestTemplate();
        HttpHeaders headers = new HttpHeaders();
        headers.set("x-rapidapi-key", "1c50bcaccdmsh24da0059f6cea8ap10c332jsn3680464f84d3");
        headers.set("x-rapidapi-host", "api-football-v1.p.rapidapi.com");
        HttpEntity<String> entity = new HttpEntity<>(headers);

        for (Integer fixtureId : fixtureIds) {
            String eventsUrl = "https://api-football-v1.p.rapidapi.com/v3/fixtures/events?fixture=" + fixtureId;

            try {
                ResponseEntity<String> response = restTemplate.exchange(eventsUrl, HttpMethod.GET, entity,
                        String.class);
                ObjectMapper objectMapper = new ObjectMapper();
                JsonNode rootNode = objectMapper.readTree(response.getBody());

                if (rootNode != null && rootNode.has("response")) {
                    JsonNode eventsNode = rootNode.get("response");

                    for (JsonNode eventNode : eventsNode) {
                        String type = eventNode.get("type").asText();
                        if (type.equals("Goal") || type.equals("Card") || type.equals("Var")) {
                            int timeElapsed = eventNode.get("time").get("elapsed").asInt();
                            int timeExtra = eventNode.get("time").get("extra").isNull() ? 0
                                    : eventNode.get("time").get("extra").asInt();
                            int time = timeElapsed + timeExtra;
                            String teamName = eventNode.get("team").get("name").asText();
                            String teamLogo = eventNode.get("team").get("logo").asText();
                            String player = eventNode.get("player").get("name").asText();
                            String assist = eventNode.has("assist") ? eventNode.get("assist").get("name").asText()
                                    : "";
                            String detail = eventNode.get("detail").asText();
                            String comments = eventNode.has("comments") ? eventNode.get("comments").asText() : "";

                            if (assist.equals("null")) {
                                assist = "";
                            }
                            if (comments.equals("null")) {
                                comments = "";
                            }

                            Event event = new Event(time, teamName, teamLogo, player, assist, type, detail,
                                    comments);
                            allEvents.add(event);
                            
                            MatchEvent matchEvent = matchEventRepository.findByTeamNameAndTimeAndPlayerNameAndAssistAndTypeAndDetailAndComments(teamName, time, player, assist, type, detail, comments);
                            
                            if (matchEvent == null) {
                            	MatchEvent matchevents = new MatchEvent();
                            	matchevents.setMatchId(fixtureId);
                            	matchevents.setTeamName(teamName);
                            	matchevents.setType(type);
                            	matchevents.setTime(time);
                            	matchevents.setTeamLogo(teamLogo);
                            	matchevents.setPlayerName(player);                    
                            	matchevents.setDetail(detail);
                            	matchevents.setAssist(assist);
                            	matchevents.setComments(comments);
                            	
                            	matchEventRepository.save(matchevents);
                            } 
                        }
                    }
                }
            } catch (IOException e) {
                e.printStackTrace();
            }
        }

        return allEvents;
    }
    
